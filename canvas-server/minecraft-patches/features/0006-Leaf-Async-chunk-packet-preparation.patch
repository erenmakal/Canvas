+    // Canvas start - Leaf - async chunk packet preparation
+    private static boolean canvas$extractChunkData(final FriendlyByteBuf buffer, final LevelChunk chunk, final io.papermc.paper.antixray.ChunkPacketInfo<net.minecraft.world.level.block.state.BlockState> chunkPacketInfo, final int expected) {
+        int chunkSectionIndex = 0;
+        for (final LevelChunkSection section : chunk.getSections()) {
+            section.write(buffer, chunkPacketInfo, chunkSectionIndex);
+            chunkSectionIndex++;
+        }
+        return buffer.writerIndex() == expected;
+    }
