+    // Canvas start - Leaf - async chunk packet preparation
+    public static void canvas$prepareChunkAsync(
+        final ServerGamePacketListenerImpl connection,
+        final ServerLevel level,
+        final LevelChunk chunk,
+        final io.canvasmc.canvas.network.AsyncChunkSender chunkSender,
+        final long chunkKey
+    ) {
+        final boolean shouldModify = level.chunkPacketBlockController.shouldModify(connection.player, chunk);
+        final net.minecraft.world.level.block.entity.BlockEntity[] blockEntities =
+            chunk.blockEntities.values().toArray(new net.minecraft.world.level.block.entity.BlockEntity[0]);
+        final java.util.Map<net.minecraft.world.level.levelgen.Heightmap.Types, long[]> heightmaps =
+            new java.util.EnumMap<>(net.minecraft.world.level.levelgen.Heightmap.Types.class);
+        for (final java.util.Map.Entry<net.minecraft.world.level.levelgen.Heightmap.Types, net.minecraft.world.level.levelgen.Heightmap> map : chunk.getHeightmaps()) {
+            if (map.getKey().sendToClient()) {
+                heightmaps.put(map.getKey(), map.getValue().getRawData().clone());
+            }
+        }
+        chunkSender.submit(
+            chunkKey,
+            () -> new ClientboundLevelChunkWithLightPacket(chunk, level.getLightEngine(), null, null, shouldModify, blockEntities, heightmaps)
+        );
+    }
+    // Canvas end - Leaf - async chunk packet preparation
