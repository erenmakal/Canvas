+        private boolean canvas$prepareChunkAsync(final int chunkX, final int chunkZ) {
+            final long chunkKey = CoordinateUtils.getChunkKey(chunkX, chunkZ);
+            if (!this.sentChunks.contains(chunkKey)) {
+                if (this.canvas$asyncSender.add(chunkKey)) {
+                    PlayerChunkSender.canvas$prepareChunkAsync(
+                        this.player.connection,
+                        this.world,
